# 1. Neon Serverless PostgreSQL (String de conexion Pooled en us-east-1 / iad1)
# Ejemplo: postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. Telegram Bot API Token entregado por @BotFather
TELEGRAM_BOT_TOKEN=

# 3. Secreto aleatorio para validar la cabecera X-Telegram-Bot-Api-Secret-Token en /api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-secure-random-webhook-secret

# 4. Secreto aleatorio para autenticar llamadas cada 60s desde cron-job.org o Cloudflare Workers (Authorization: Bearer <CRON_SECRET>) hacia /api/cron/dispatch
CRON_SECRET=replace-with-secure-random-cron-secret

# 5. Secreto HMAC-SHA256 para firmar la cookie HttpOnly clinical_session
SESSION_SECRET=replace-with-secure-random-session-secret

# 6. Credenciales iniciales de acceso web (opcionales; tambien editables desde Expediente -> Cuentas de Acceso)
CLINICAL_ADMIN_USER=admin
CLINICAL_ADMIN_PASSWORD=AdminClinico2026!
CLINICAL_PATIENT_USER=papa
CLINICAL_PATIENT_PASSWORD=Salud2026
